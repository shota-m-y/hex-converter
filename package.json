{
  "name": "hex-converter",
  "displayName": "Hex Converter",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "shota",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakayams/hex-converter.git"
  },
  "bugs": {
    "url": "https://github.com/nakayams/hex-converter/issues"
  },
  "homepage": "https://github.com/nakayams/hex-converter#readme",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hex",
    "binary",
    "decimal",
    "ascii",
    "converter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "hexConverter.showPopup",
        "title": "%command.showPopup%",
        "category": "Hex Converter"
      },
      {
        "command": "hexConverter.openConverter",
        "title": "%command.openConverter%",
        "category": "Hex Converter",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "hexConverter.replace",
        "title": "%command.replace%",
        "category": "Hex Converter"
      },
      {
        "command": "hexConverter.copy",
        "title": "%command.copy%",
        "category": "Hex Converter"
      },
      {
        "command": "hexConverter.replaceWith",
        "title": "%command.replaceWith%",
        "category": "Hex Converter"
      }
    ],
    "keybindings": [
      {
        "command": "hexConverter.showPopup",
        "key": "ctrl+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "hexConverter.replace",
        "key": "ctrl+alt+j",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "hexConverter.openConverter",
        "key": "ctrl+alt+shift+h"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hexConverter.copy",
          "when": "false"
        },
        {
          "command": "hexConverter.replaceWith",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "hexConverter.showPopup",
          "group": "9_hexConverter@1"
        },
        {
          "command": "hexConverter.replace",
          "when": "!editorReadonly",
          "group": "9_hexConverter@2"
        },
        {
          "command": "hexConverter.openConverter",
          "group": "9_hexConverter@3"
        }
      ]
    },
    "configuration": {
      "title": "Hex Converter",
      "properties": {
        "hexConverter.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.hover.enabled%"
        },
        "hexConverter.hover.decimal": {
          "type": "boolean",
          "default": true,
          "description": "%config.hover.decimal%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "@types/vscode": "~1.82.0",
    "typescript": "~5.4.5"
  }
}
